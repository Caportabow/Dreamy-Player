# ------------------------------------------------------------------
# Dreamy environment configuration
# Copy to .env and fill in real values. Never commit real secrets.
# ------------------------------------------------------------------

# PostgreSQL
DATABASE_URL=postgres://dreamy:dreamy@localhost:5432/dreamy

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_AUDIO_BUCKET=audio
MINIO_ARTWORK_BUCKET=artwork
MINIO_AVATARS_BUCKET=avatars

# Sessions
SESSION_SECRET=replace-with-a-long-random-string
SESSION_TTL_DAYS=30

# Download worker
DOWNLOAD_SERVICE_URL=http://localhost:8787
DOWNLOAD_SERVICE_SECRET=replace-with-a-shared-secret

# Cloudflare Tunnel (optional): token from Zero Trust > Networks > Tunnels >
# your tunnel > "Install and run a connector". Leave empty to skip the tunnel.
TUNNEL_TOKEN=

# Passkeys (optional): pin the WebAuthn relying-party id and origin. Leave empty
# to derive them from each request's host (works on localhost and the tunnel).
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# In production set NODE_ENV=production so cookies use Secure.
NODE_ENV=development
